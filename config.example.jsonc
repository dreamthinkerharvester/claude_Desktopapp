// SNS 발행기 설정 파일
// - "//" 뒤는 설명입니다. 값만 바꾸면 됩니다.
// - API 키가 들어가므로 공유하거나 깃허브에 올리지 마세요 (config.jsonc 는 .gitignore 로 빠져 있습니다).
// - 고친 뒤에는 실행기를 다시 켜야 반영됩니다 (launchd 로 켰다면: snspub install-launchd 한 번 더).
{
  // 시간대 (예약 시각 입력·표시 기준)
  "timezone": "Asia/Seoul",

  // 웹 화면 주소: http://127.0.0.1:4310
  "port": 4310,

  // 올릴 콘텐츠가 모이는 폴더. [새 발행] 화면에 이 폴더의 영상·카드뉴스 폴더가 보입니다.
  "inboxDir": "/Volumes/MacData/1. 최종콘텐츠/업로드 예정",

  // 선택한 채널에 모두 올라가면 원본을 옮길 보관 폴더 (월별 하위 폴더 자동 생성). 비우면 옮기지 않습니다.
  // 수신함(inboxDir) 안에 있는 파일만 옮깁니다.
  "archiveDir": "/Volumes/MacData/1. 최종콘텐츠/_업로드완료",

  // 작업 기록(DB)·로그 위치. 외장 디스크보다 맥 내장 디스크를 권장합니다.
  "dataDir": "./data",

  // macOS 알림 (확인 필요·실패·직접 올릴 차례·완료)
  "notify": true,

  // AI 로 만든 사실적인 영상이면 true → YouTube '변경/합성 콘텐츠', TikTok 'AI 생성' 표시를 켭니다 (미표시 페널티 예방)
  "aiGenerated": true,

  "schedule": {
    // 채널 올리는 순서 (앞 채널부터 예약)
    "order": ["youtube", "instagram", "facebook", "tiktok", "threads", "x", "naver_clip", "naver_cafe"],
    // 채널 사이 간격(분). 최소~최대 사이에서 무작위로 정합니다.
    "gapMinutes": [25, 40],
    // 같은 채널에 연달아 올리지 않는 최소 간격(분). 밀린 예약이 한꺼번에 올라가는 것을 막습니다.
    "minGapSameChannelMinutes": 60
  },

  // 자동 재시도: 연결 끊김·일시 장애일 때만 합니다.
  // 게시됐는지 알 수 없는 경우에는 중복을 막기 위해 재시도하지 않고 '확인 필요'로 멈춥니다.
  "retry": { "maxAttempts": 5, "backoffMinutes": [1, 5, 15, 30, 60] },

  "captions": {
    // 채널별 문구 틀. {caption}=소개글, {hashtags}=해시태그, {title}=제목, {links}=먼저 올라간 채널 주소
    "templates": {
      "default": "{caption}\n\n{hashtags}",
      "x": "{caption}\n{hashtags}",
      "naver_cafe": "{caption}\n\n{links}"
    },
    // 채널별 해시태그 최대 개수 (너무 많으면 스팸처럼 보여 노출이 줄 수 있음)
    "maxHashtags": { "x": 2, "threads": 1, "instagram": 5, "tiktok": 5, "youtube": 3, "facebook": 3, "naver_clip": 5, "naver_cafe": 10 }
  },

  // ─────────────────────────────────────────────────────────────
  // 채널별 게시 경로 (route)
  //   "uploadpost" : Upload-Post 게시 대행. 유료(월 $16~24)지만 가장 간단하고 안정적.
  //                  YouTube·TikTok 심사를 업체가 대신 통과해 둠 → 보고서 권장안
  //   "meta"       : Instagram·Facebook 직접 연결. 무료. (Instagram 은 영상만, 카드뉴스는 imagesRoute 로)
  //   "youtube"    : YouTube 직접 연결. 무료. 단, Google API 감사 통과 전에는 영상이 비공개로 잠김
  //   "naver_cafe" : 네이버 카페 공식 API. 무료. (영상은 소개글 + 링크로)
  //   "manual"     : 업로드 도우미 (반자동). 소개글 복사 + 업로드 페이지·파일 열기 → 직접 올린 뒤 [완료]
  // imagesRoute    : 카드뉴스(이미지)만 다른 경로로 보내고 싶을 때 (예: "imagesRoute": "uploadpost")
  //
  // 무료로만 쓰고 싶다면 예) youtube: "youtube"(감사 후) / instagram·facebook: "meta"
  //                         tiktok·threads·x·naver_clip: "manual" / naver_cafe: "naver_cafe"
  // ─────────────────────────────────────────────────────────────
  "channels": {
    "youtube":    { "enabled": true, "route": "uploadpost" },
    "instagram":  { "enabled": true, "route": "uploadpost" },
    "facebook":   { "enabled": true, "route": "uploadpost" },
    "tiktok":     { "enabled": true, "route": "uploadpost" },
    "threads":    { "enabled": true, "route": "uploadpost" },
    "x":          { "enabled": true, "route": "uploadpost" },
    "naver_clip": { "enabled": true, "route": "manual" },
    "naver_cafe": { "enabled": true, "route": "naver_cafe" }
  },

  "routes": {
    "uploadpost": {
      // https://app.upload-post.com → API Keys 에서 발급
      "apiKey": "",
      // Upload-Post 에서 만든 프로필 이름 (이 프로필에 SNS 계정들을 연결해 둡니다)
      "user": "",
      // Facebook 페이지가 여러 개일 때만: 올릴 페이지 ID
      "facebookPageId": "",
      "youtube": { "privacy": "public", "categoryId": "22" },
      // TikTok 공개 범위: PUBLIC_TO_EVERYONE / MUTUAL_FOLLOW_FRIENDS / FOLLOWER_OF_CREATOR / SELF_ONLY
      "tiktok": { "privacy": "PUBLIC_TO_EVERYONE", "disableComment": false }
    },

    "meta": {
      // developers.facebook.com 에서 만든 앱. 개발 모드 그대로 두고 본인이 관리자면 검수가 필요 없습니다.
      "appId": "",
      "appSecret": "",
      // 올릴 Facebook 페이지 ID (비워 두면 권한 있는 페이지가 1개일 때 자동 선택)
      "pageId": "",
      "graphVersion": "v26.0"
    },

    "youtube": {
      // Google Cloud 콘솔 → 사용자 인증 정보 → OAuth 클라이언트 ID (유형: 데스크톱 앱)
      "clientId": "",
      "clientSecret": "",
      // YouTube API 감사(audit)를 통과한 뒤에만 true 로 바꾸세요. 그 전에 올린 영상은 비공개로 잠깁니다.
      "audited": false,
      "privacy": "public",
      "categoryId": "22",
      "notifySubscribers": true
    },

    "naver_cafe": {
      // developers.naver.com → 애플리케이션 등록
      //   사용 API: 카페 / 환경: PC 웹 / Callback URL: http://127.0.0.1:4310/oauth/naver/callback
      "clientId": "",
      "clientSecret": "",
      // 게시판을 클릭했을 때 주소 https://cafe.naver.com/f-e/cafes/{clubId}/menus/{menuId} 의 숫자
      "clubId": "",
      "menuId": "",
      // true = 전체 공개, false = 멤버 공개 (API 기본값은 멤버 공개)
      "public": true
    },

    "manual": {
      // 업로드 도우미가 여는 페이지
      "urls": {
        "naver_clip": "https://clipcreators.naver.com/",
        "tiktok": "https://www.tiktok.com/tiktokstudio/upload",
        "x": "https://x.com/compose/post",
        "threads": "https://www.threads.com/",
        "instagram": "https://www.instagram.com/",
        "facebook": "https://business.facebook.com/latest/home",
        "youtube": "https://studio.youtube.com/",
        "naver_cafe": "https://cafe.naver.com/"
      }
    }
  }
}
