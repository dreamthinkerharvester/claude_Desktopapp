// snspub import examples/post.example.jsonc --dry-run   ← 확인
// snspub import examples/post.example.jsonc             ← 등록
//
// Claude Code 세션에 "이 형식으로 채널별 소개글 JSON 을 만들어 줘" 라고 요청하면 됩니다.
// - media     : 영상 1개 경로, 또는 카드뉴스 폴더 경로 (상대 경로는 이 파일 기준)
// - at        : 첫 채널 시각 (없으면 지금). 이후 채널은 gapMinutes 간격
// - channels  : 생략하면 config.jsonc 에서 켜진 채널 전부
// - overrides.<채널>.text     : 그 채널에 그대로 올릴 최종 문구
// - overrides.<채널>.title    : 제목 (YouTube 제목, 네이버 카페 글 제목)
// - times.<채널>              : 그 채널만 시각 지정
{
  "posts": [
    {
      "media": "/Volumes/MacData/1. 최종콘텐츠/업로드 예정/통화형_C1_전세금.mp4",
      "title": "전세금 못 받을 때, 임차권등기명령부터 하세요",
      "caption": "계약이 끝났는데 전세금을 못 돌려받았다면, 이사 가기 전에 임차권등기명령부터 신청하세요. 이사를 가도 대항력과 우선변제권이 유지됩니다.",
      "hashtags": ["전세금", "임차권등기명령", "법률상식", "부동산"],
      "at": "2026-09-28 12:50",
      "gapMinutes": [25, 40],
      "overrides": {
        "x": {
          "text": "전세금 못 받았는데 이사 가야 한다면? 이사 전에 임차권등기명령부터. 대항력이 그대로 남습니다. #전세금"
        },
        "threads": {
          "text": "전세금 못 돌려받은 채로 이사 가도 될까요?\n\n임차권등기명령을 먼저 해 두면 이사를 가도 대항력과 우선변제권이 유지됩니다. #전세금"
        },
        "naver_cafe": {
          "title": "[법률상식] 전세금 못 받을 때 임차권등기명령 먼저",
          "text": "계약이 끝났는데 전세금을 못 돌려받았다면 이사 전에 임차권등기명령부터 신청하세요.\n이사를 가도 대항력과 우선변제권이 유지됩니다.\n\n영상으로 보기\n{links}"
        }
      }
    }
  ]
}
